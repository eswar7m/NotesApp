@{
    ViewData["Title"] = "Delete";
}

@model Note

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Delete Note</h2>
            <hr />
        </div>
        <div class="mb-3">
            <label>Id</label>
            <input class="form-control" asp-for="Id" hidden />
        </div>
        <div class="mb-3">
            <label>Title</label>
            <input class="form-control" asp-for="Title" readonly />
        </div>
        <div class="mb-3">
            <label>Description</label>
            <input class="form-control" asp-for="Description" readonly />
        </div>
        <div class="d-flex gap-3">
            <button class="btn btn-primary" type="submit">Delete</button>
			<a class ="btn btn-secondary" asp-controller="Notes" asp-action="Index">
                Back to List
            </a>
        </div>
    </div>
</form>
