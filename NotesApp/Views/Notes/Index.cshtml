@{
    ViewData["Title"] = "Notes";
}

@model List<Note>
    

<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
			<h2 class="text-primary">Notes</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Notes" asp-action="Upsert" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary">
				<i class="bi bi-file-earmark-plus"></i> <span>Create new Note</span>
            </a>
        </div>
	</div>
</div>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Note note in Model)
        {
            <tr>
                <td>@note.Title</td>
                <td>@note.Description</td>
				<td>
                    <div class="btn-group d-flex"  gap-3">
                        <a asp-controller="Notes" asp-action="Upsert" asp-route-id="@note.Id" asp-route-returnUrl="@Context.Request.Path"
                           class="btn btn-primary">Edit
                        </a>
                        <a asp-controller="Notes" asp-action="Delete" asp-route-id="@note.Id"
                            class="btn btn-secondary">Delete
                        </a>
                    </div>

                </td>
			</tr>
        }
    </tbody>
</table>
