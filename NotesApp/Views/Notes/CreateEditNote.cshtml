@{
    ViewData["Title"] = "Create / Edit";
}

@model Note

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Create/edit a Note</h2>
            <hr/>
        </div>
        <div class="mb-3">
            <label>Title</label>
		    <input class="form-control" asp-for="Title"/>
	    </div>
        <div class="mb-3">
            <label>Description</label>
            <input class="form-control" asp-for="Description"/>
        </div>
        <div class="d-flex gap-3">
			<button class="btn btn-primary" type="submit">Submit</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left-circle"></i> <span>Back</span>
            </a>
		</div>
	</div>
</form>
